<controls:PluginUserControl x:Class="AutoInjectPlugin.DuplicateGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK">
    <DockPanel Margin="20">
        <Button x:Name="StartButton"
                DockPanel.Dock="Top"
                HorizontalAlignment="Left"
                Padding="12,6"
                Content="开始检查重复游戏"
                Click="StartButton_Click" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>
    </DockPanel>
</controls:PluginUserControl>
